# Every input the AppImage build fetches, pinned. Sourced by build.sh and by the image scripts.
#
# A checksum is only ever changed together with its version, after checking the new file against
# the upstream signature or checksum listed beside it (README.md, "Updating the pins").

# Build image. Ubuntu 24.04 sets the oldest glibc the AppImage supports (2.39). The digest is
# Docker Hub's official ubuntu:24.04; it is pulled through Google's public mirror of Docker Hub,
# which serves the same digest without Docker Hub's anonymous rate limit.
BASE_IMAGE=mirror.gcr.io/library/ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c
# Every Ubuntu package comes from this dated, immutable archive snapshot (signed by the Ubuntu
# archive key, like the live archive).
UBUNTU_SNAPSHOT=20261027T000000Z

# Rust toolchain. Hashes from channel-rust-stable.toml for 2026-10-15, whose signature by the Rust
# release key (108F 6620 5EAE B0AA A8DD 5E1C 85AB 96E6 FA1B E5FE) was verified.
RUST_VERSION=1.99.1
RUSTC_SHA256=2ff05ff9c08a90861e7f6e4065b40a8b87463b4576186fd613871c3e37f2091f
RUST_STD_SHA256=109b074225bf5b9ea3820890876bfdf4ed161adbfaf94b2b4b5984c85ee5d958
CARGO_SHA256=53f3521949404d595efb06a55c12c5658d4ed1c75566f33d3d514eaebe70bd8a

# GTK and libadwaita: the newest releases that build against Ubuntu 24.04's glib, pango, cairo,
# and harfbuzz (GTK 4.18 needs pango 1.56). TarDrop needs libadwaita >= 1.6. Hashes from the
# .sha256sum files on download.gnome.org.
GTK_VERSION=4.16.13
GTK_SHA256=ddf3d9e12b848139a945d191d5ca56b78d0647f53b55b8bca5f9902b61624498
LIBADWAITA_VERSION=1.6.10
LIBADWAITA_SHA256=714a486e748e1b7de29101436fba3bbb61f74997f373c6af9651e23e859eb1f6
# Build-time protocol XML only; GTK 4.16 needs >= 1.36 and Ubuntu 24.04 has 1.34. Signature by
# 8307 C0A2 24BA BDA1 BABD 0EB9 A6EE EC9E 0136 164A was verified.
WAYLAND_PROTOCOLS_VERSION=1.36
WAYLAND_PROTOCOLS_SHA256=71fd4de05e79f9a1ca559fac30c1f8365fa10346422f9fe795f74d77b9ef7e92

# AppImage tooling, by release tag (never "continuous"). linuxdeploy's SHA-1 matched its upstream
# .zsync; appimagetool publishes no digest, so its hash is trust-on-first-use. Only the runtime
# ends up inside the AppImage, and it is checked against its upstream signature on every build.
LINUXDEPLOY_TAG=1-alpha-20251107-1
LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d
APPIMAGETOOL_TAG=1.9.1
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
RUNTIME_TAG=20251108
RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
# keys/type2-runtime.asc, from github.com/AppImage/type2-runtime at tag 20251108.
RUNTIME_SIGNING_KEY=570C77ACEA40C0F1B758902CBF96CCA56490F695
